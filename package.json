{
  "name": "youtube-chinese-reader",
  "version": "1.2.0",
  "description": "Chrome extension for OCR of hard-coded Chinese subtitles on YouTube videos",
  "scripts": {
    "build": "node esbuild.config.js",
    "lint": "eslint extension/ --ext .js",
    "lint:hooks": "eslint .copilot/hooks/log_activity.cjs .claude/hooks/log_activity.cjs tests/audit-hooks.test.cjs && bash -n .copilot/hooks/run-audit.sh && bash -n .claude/hooks/run-audit.sh",
    "test:hooks": "node --test tests/audit-hooks.test.cjs",
    "watch": "node esbuild.config.js --watch"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@tesseract.js-data/chi_sim": "^1.0.0",
    "@tesseract.js-data/chi_tra": "^1.0.0",
    "onnxruntime-web": "^1.24.3",
    "opencc-js": "^1.0.5",
    "pinyin-pro": "^3.28.1",
    "pinyin-zhuyin": "^1.0.4",
    "ppu-paddle-ocr": "^4.1.1",
    "sharp": "^0.34.5",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.27.4",
    "eslint": "^10.1.0",
    "globals": "^17.4.0",
    "playwright": "^1.65.1"
  }
}
