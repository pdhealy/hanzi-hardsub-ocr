{
	"name": "Debian Slim (Host Ollama, Claude, Copilot CLI)",
	"build": {
		"dockerfile": "Dockerfile"
	},
	"remoteUser": "vscode",
	"init": true,
	"hostRequirements": {
		"cpus": 2,
		"memory": "4gb",
		"storage": "32gb"
	},
	"waitFor": "postStartCommand",
	"postCreateCommand": "install -D /usr/local/bin/copilot /home/vscode/.local/bin/copilot",
	"postStartCommand": "openssl x509 -inform PEM -in /usr/local/share/ca-certificates/cisco-root.crt -noout && sudo -n /usr/sbin/update-ca-certificates",
	"remoteEnv": {
		"PATH": "/home/vscode/.local/bin:${containerEnv:PATH}"
	},
	"features": {
		"ghcr.io/devcontainers/features/copilot-cli:1.1.4": {},
		"ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {},
		"ghcr.io/devcontainers/features/github-cli:1": {}
	},
	"mounts": [
		"source=${devcontainerId}-copilot,target=/home/vscode/.copilot,type=volume",
		"source=${devcontainerId}-claude,target=/home/vscode/.claude,type=volume",
		"source=${devcontainerId}-gemini,target=/home/vscode/.gemini,type=volume",
		"source=${devcontainerId}-codex,target=/home/vscode/.codex,type=volume",
		"source=${devcontainerId}-local,target=/home/vscode/.local,type=volume",
		"source=${localEnv:HOME}/.config/devcontainer-certs,target=/run/devcontainer-certs,type=bind,readonly"
	],
	"containerEnv": {
		"OLLAMA_HOST": "http://host.docker.internal:11434",
		"CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
		"CODEX_HOME": "/home/vscode/.codex"
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"anthropic.claude-code",
				"ms-azuretools.vscode-containers"
			],
			"settings": {
				"terminal.integrated.defaultProfile.linux": "bash"
			}
		}
	}
}
